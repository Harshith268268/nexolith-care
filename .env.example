# Nexolith Care - Environment Variables Reference

# --- Frontend Environment Variables ---
# Base API URL pointing to deployed Django backend REST API
VITE_API_BASE_URL=http://localhost:8000

# --- Backend Environment Variables ---
# Set to 'False' in production!
DEBUG=True

# Django Cryptographic Secret Key (Required in Production)
SECRET_KEY=django-insecure-nexolith-care-prod-key-2026

# Allowed Hosts (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.render.com,.vercel.app

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# CSRF Trusted Origins (Comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.railway.app,https://*.vercel.app

# Database URL (Required: PostgreSQL used for both local development and production)
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/nexolith_care

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nexolith Care <noreply@nexolithcare.com>

# Tesseract OCR Command Path (Windows optional override)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
